# Python bytecode cache
__pycache__/
*.pyc

# Never commit API keys
.env
.env.local
*.key

# Dry-run payloads are regenerable from code+data (real raw/*.json are NOT —
# they are irreproducible model outputs and belong in git as evidence).
# Both layouts are covered: EXP001's results/raw/ and EXP002's results/<exp>/raw/.
results/raw/DRY__*
results/*/raw/DRY__*
